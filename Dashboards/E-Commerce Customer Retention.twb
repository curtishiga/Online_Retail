      <table>
        <view>
          <datasources>
            <datasource caption='Customer Churn (Online Retail_Analysis)' name='federated.1piumxe0dz9pik10vfw5j1254qe6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Start Date' datatype='date' name='[Parameter 0900269981880327]' param-domain-type='range' role='measure' type='quantitative' value='#2010-12-01#'>
              <calculation class='tableau' formula='#2010-12-01#' />
              <range max='#2011-12-31#' min='#2010-12-01#' />
            </column>
            <column caption='End Date' datatype='date' name='[Parameter 0900269982040072]' param-domain-type='range' role='measure' type='quantitative' value='#2011-03-31#'>
              <calculation class='tableau' formula='#2011-03-31#' />
              <range max='#2011-12-31#' min='#2010-12-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1piumxe0dz9pik10vfw5j1254qe6'>
            <column caption='Date Range Filter' datatype='boolean' name='[Calculation_0741391593033728]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[InvoiceDate] &gt;= [Parameters].[Parameter 0900269981880327] AND [InvoiceDate] &lt;= [Parameters].[Parameter 0900269982040072]' />
            </column>
            <column caption='Customer Lifetime' datatype='integer' default-format='*#,##0.0 Days' name='[Calculation_0900270040199197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF FLOAT([Churn]) = 1 &#13;&#10;        AND [Churn Date] &lt;= [Parameters].[Parameter 0900269982040072]&#13;&#10;THEN {FIXED [CustomerID]:&#13;&#10;        DATEDIFF(&apos;day&apos;,&#13;&#10;                MIN([InvoiceDate]),&#13;&#10;                MAX(IF [InvoiceDate] &lt;= [Parameters].[Parameter 0900269982040072] THEN [InvoiceDate] END))}&#13;&#10;END' />
            </column>
            <column datatype='date' name='[Churn Date]' role='dimension' type='ordinal' />
            <column datatype='boolean' name='[Churn]' role='dimension' type='nominal' />
            <column caption='Customer ID' datatype='integer' name='[CustomerID]' role='dimension' type='ordinal' />
            <column caption='Invoice Date' datatype='date' name='[InvoiceDate]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_0900270040199197]' derivation='Avg' name='[avg:Calculation_0900270040199197:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0741391593033728]' derivation='None' name='[none:Calculation_0741391593033728:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
