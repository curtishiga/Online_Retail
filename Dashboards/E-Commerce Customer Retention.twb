    <worksheet name='Cohort Retention %'>
      <table>
        <view>
          <datasources>
            <datasource caption='Cohorts Pct (Online Retail_Analysis)' name='federated.1k6go070f8q6ww1c8dd360z09h5a' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='End Date' datatype='date' name='[Parameter 0900269982040072]' param-domain-type='range' role='measure' type='quantitative' value='#2011-03-31#'>
              <calculation class='tableau' formula='#2011-03-31#' />
              <range max='#2011-12-31#' min='#2010-12-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1k6go070f8q6ww1c8dd360z09h5a'>
            <column caption='Cohort Retention Pct' datatype='real' name='[Calculation_0485479878692864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([CustomerID])/MIN({FIXED [Cohort]: COUNTD([CustomerID])}) * 100' />
            </column>
            <column caption='&quot;Cohort&quot;' datatype='datetime' name='[Calculation_0485479890628615]' role='dimension' type='ordinal' user:unnamed='Cohort Retention %'>
              <calculation class='tableau' formula='//&quot;Cohort&quot; &#13;&#10;&#13;&#10;IF [InvoiceDate] &lt;= [Parameters].[Parameter 0900269982040072] THEN DATETRUNC(&apos;month&apos;, [FirstInvoiceDate]) ELSE NULL END' />
            </column>
            <column caption='Relative Invoice Date Filter' datatype='boolean' name='[Calculation_0485479891247112]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[InvoiceDate] &lt;= [Parameters].[Parameter 0900269982040072]' />
            </column>
