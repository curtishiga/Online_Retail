              <calculation class='tableau' formula='{FIXED [CustomerID]: MAX(IF [InvoiceDate] &lt;= [Parameters].[Parameter 0900269982040072] THEN [RollingTotalPrice] END)}' />
            </column>
            <column caption='Customer Rolling Days Between Purchases' datatype='real' name='[Calculation_0485479897800714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [CustomerID]: AVG(IF [InvoiceDate] &lt;= [Parameters].[Parameter 0900269982040072] THEN [RollingAvgDaysBetweenPurchases] END)}' />
