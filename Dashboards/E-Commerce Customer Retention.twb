          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Start Date' datatype='date' name='[Parameter 0900269981880327]' param-domain-type='range' role='measure' type='quantitative' value='#2010-12-01#'>
              <calculation class='tableau' formula='#2010-12-01#' />
              <range max='#2011-12-31#' min='#2010-12-01#' />
            </column>
            <column caption='End Date' datatype='date' name='[Parameter 0900269982040072]' param-domain-type='range' role='measure' type='quantitative' value='#2011-03-31#'>
              <calculation class='tableau' formula='#2011-03-31#' />
              <range max='#2011-12-31#' min='#2010-12-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1piumxe0dz9pik10vfw5j1254qe6'>
            <column caption='Date Range Filter' datatype='boolean' name='[Calculation_0741391593033728]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[InvoiceDate] &gt;= [Parameters].[Parameter 0900269981880327] AND [InvoiceDate] &lt;= [Parameters].[Parameter 0900269982040072]' />
            </column>
            <column caption='Churned Customers' datatype='real' default-format='p0.00%' name='[Calculation_0900269971161088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF FLOAT([Churn]) = 1  AND [Churn Date] &lt;= [Parameters].[Parameter 0900269982040072] THEN [CustomerID] END)/COUNTD([CustomerID])' />
            </column>
            <column caption='Pct Churned Fraction' datatype='string' name='[Calculation_0900269973417985]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(COUNTD(IF [Calculation_0900270000766992] = TRUE THEN [CustomerID] END)) + &quot;/&quot; + STR(COUNTD([CustomerID]))' />
            </column>
            <column caption='Churn Date Filter' datatype='boolean' name='[Calculation_0900270000766992]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([Churn Date] &lt;= [Parameters].[Parameter 0900269982040072]) AND ([Churn] = TRUE)' />
            </column>
