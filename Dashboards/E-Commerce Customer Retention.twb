      <aliases enabled='yes' />
      <column caption='Customer Rolling Spend' datatype='real' name='[Calculation_0485479897128969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [CustomerID]: MAX(IF [InvoiceDate] &lt;= [Parameters].[Parameter 0900269982040072] THEN [RollingTotalPrice] END)}' />
      </column>
      <column caption='Customer Rolling Days Between Purchases' datatype='real' name='[Calculation_0485479897800714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [CustomerID]: AVG(IF [InvoiceDate] &lt;= [Parameters].[Parameter 0900269982040072] THEN [RollingAvgDaysBetweenPurchases] END)}' />
      </column>
      <column caption='Customer Rolling Num Invoices' datatype='integer' name='[Calculation_0675421229277188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [CustomerID]: MAX(IF [InvoiceDate] &lt;= [Parameters].[Parameter 0900269982040072] THEN [RollingNumInvoices] END)}' />
      </column>
      <column caption='Date Range Filter' datatype='boolean' name='[Calculation_0741391593033728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[InvoiceDate] &gt;= [Parameters].[Parameter 0900269981880327] AND [InvoiceDate] &lt;= [Parameters].[Parameter 0900269982040072]' />
      </column>
      <column caption='Customer Cohort' datatype='date' name='[Calculation_0741391595155457]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [CustomerID] : MIN(IF [Calculation_0741391593033728] = TRUE THEN [InvoiceDate] END)}' />
      </column>
      <column caption='Churned Customers' datatype='real' default-format='p0.00%' name='[Calculation_0900269971161088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF FLOAT([Churn]) = 1  AND [Churn Date] &lt;= [Parameters].[Parameter 0900269982040072] THEN [CustomerID] END)/COUNTD([CustomerID])' />
      </column>
      <column caption='Pct Churned Fraction' datatype='string' name='[Calculation_0900269973417985]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(COUNTD(IF [Calculation_0900270000766992] = TRUE THEN [CustomerID] END)) + &quot;/&quot; + STR(COUNTD([CustomerID]))' />
      </column>
      <column caption='Churned Revenue' datatype='real' default-format='C1033%' name='[Calculation_0900269975216130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    {&#13;&#10;    FIXED [CustomerID]: &#13;&#10;    MAX( IF &#13;&#10;            [Churn] = TRUE AND [Churn Date] &lt;= [Parameters].[Parameter 0900269982040072]&#13;&#10;        THEN [RollingTotalPrice]&#13;&#10;        END&#13;&#10;        )&#13;&#10;    }&#13;&#10;)' />
      </column>
      <column caption='Customer Date Range Filter' datatype='boolean' name='[Calculation_0900269982150665]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[InvoiceDate] = {FIXED [CustomerID]: MAX(IF [Calculation_0741391593033728] = TRUE THEN [InvoiceDate] END)}' />
      </column>
      <column caption='Churn Date Filter' datatype='boolean' name='[Calculation_0900270000766992]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([Churn Date] &lt;= [Parameters].[Parameter 0900269982040072]) AND ([Churn] = TRUE)' />
      </column>
      <column caption='Active Customers' datatype='integer' name='[Calculation_0900270021230609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;  IF [Calculation_0741391593033728] = TRUE&#13;&#10;  THEN [CustomerID] &#13;&#10;  END&#13;&#10;) -&#13;&#10;(COUNTD(&#13;&#10;    IF [Calculation_0900270000766992] = TRUE&#13;&#10;    THEN [CustomerID]&#13;&#10;    END&#13;&#10;    )&#13;&#10;)' />
      </column>
      <column caption='Prior Month Active Customers' datatype='integer' name='[Calculation_0900270025170964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;  IF [InvoiceDate] &gt;= [Parameters].[Parameter 0900269981880327]&#13;&#10;    AND [InvoiceDate] &lt;= DATEADD(&apos;day&apos;,-30,[Parameters].[Parameter 0900269982040072])&#13;&#10;  THEN [CustomerID] &#13;&#10;  END&#13;&#10;) -&#13;&#10;(COUNTD(&#13;&#10;    IF FLOAT([Churn]) = 1 &#13;&#10;        AND [Churn Date] &lt;= DATEADD(&apos;day&apos;,-30,[Parameters].[Parameter 0900269982040072])&#13;&#10;    THEN [CustomerID]&#13;&#10;    END&#13;&#10;    )&#13;&#10;)' />
      </column>
      <column caption='MoM Active Customer Diff' datatype='string' name='[Calculation_0900270025682965]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_0900270021230609] &gt; [Calculation_0900270025170964])&#13;&#10;    THEN &quot;+&quot; + STR([Calculation_0900270021230609] - [Calculation_0900270025170964]) + &quot; MoM Change&quot;&#13;&#10;ELSEIF ([Calculation_0900270021230609] &lt; [Calculation_0900270025170964])&#13;&#10;    THEN STR([Calculation_0900270021230609] - [Calculation_0900270025170964]) + &quot; MoM Change&quot;&#13;&#10;ELSE STR(0) + &quot; MoM Change&quot;&#13;&#10;END' />
      </column>
      <column caption='Customer Lifetime' datatype='integer' default-format='*#,##0.0 Days' name='[Calculation_0900270040199197]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF FLOAT([Churn]) = 1 &#13;&#10;        AND [Churn Date] &lt;= [Parameters].[Parameter 0900269982040072]&#13;&#10;THEN {FIXED [CustomerID]:&#13;&#10;        DATEDIFF(&apos;day&apos;,&#13;&#10;                MIN([InvoiceDate]),&#13;&#10;                MAX(IF [InvoiceDate] &lt;= [Parameters].[Parameter 0900269982040072] THEN [InvoiceDate] END))}&#13;&#10;END' />
      </column>
